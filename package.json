{
  "name": "the-club",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "serve:api": "tsx src/api/main.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "dev:web": "vite --config web/vite.config.mts",
    "build:web": "vite build --config web/vite.config.mts",
    "test:postgres": "tsx --test src/services/postgres-club-repository.integration.test.ts",
    "refresh:official-data": "tsx src/jobs/official-data-refresh.ts",
    "refresh:official-data:alert-test": "tsx src/jobs/official-data-refresh.ts --test-alert",
    "refresh:official-data:once": "tsx src/jobs/official-data-refresh.ts --once"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "fastify": "^5.12.8",
    "file-type": "^21.3.4",
    "jose": "^6.2.16",
    "lucide-react": "^1.70.0",
    "oidc-client-ts": "^3.5.0",
    "pg": "^8.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.7"
  }
}
