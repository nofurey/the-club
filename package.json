{
  "name": "the-club",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "tunnel:up": "bash scripts/tunnel-up.sh",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "build:web": "vite build --config web/vite.config.mts",
    "test:postgres": "tsx --test src/services/postgres-club-repository.integration.test.ts",
    "retention:cleanup:container": "docker compose --env-file ${HOME}/.config/the-club/refresh.env --env-file ${HOME}/.config/the-club/cloudflare-tunnel.env -f deploy/tunnel/compose.yaml run --rm api ./node_modules/.bin/tsx src/jobs/retention-cleanup.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/multipart": "^10.1.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "fastify": "^5.12.8",
    "file-type": "^21.3.4",
    "jose": "^6.2.16",
    "lucide-react": "^1.70.0",
    "nodemailer": "^10.5.0",
    "oidc-client-ts": "^3.5.0",
    "pg": "^8.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "pg-mem": "^3.0.14",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^8.3.7"
  }
}
