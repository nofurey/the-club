# Set to true only for the local demo adapter. Authenticated mode is the default.
VITE_USE_DEMO_API=false

# OIDC SPA client registration: use Authorization Code + PKCE, no client secret.
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/the-club-dev
VITE_OIDC_CLIENT_ID=the-club-web
VITE_OIDC_SCOPE=openid profile email
# Optional overrides must match the browser origin and the identity-provider allow-list.
# VITE_OIDC_REDIRECT_URI=
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=

# The Vite dev server proxies /api to the localhost-only API by default.
VITE_API_BASE_URL=/api/v1
# Optional initial club selection. Omit to use an active membership or open discovery.
# VITE_CLUB_ID=