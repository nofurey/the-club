[Unit]
Description=The Club official lottery data refresh worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=the-club
Group=the-club
WorkingDirectory=/opt/the-club/current
EnvironmentFile=/etc/the-club/refresh.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node node_modules/tsx/dist/cli.mjs src/jobs/official-data-refresh.ts
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
