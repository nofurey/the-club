[Unit]
Description=Test The Club official-data refresh alert webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/repos/the-club
Environment=NODE_ENV=development
EnvironmentFile=%h/.config/the-club/refresh.env
ExecStart=%h/repos/the-club/node_modules/.bin/tsx src/jobs/official-data-refresh.ts --test-alert
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StandardOutput=journal
StandardError=journal
